@model Library_Management_System.ViewModels.BooksViewModel

@{
    ViewData["Title"] = "Books";
    ViewData["ActiveMenu"] = "Book";
    ViewData["PageHeading"] = "Book Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="@Url.Action("Create", "Book")" class="btn shadow-sm btn-addButton">
        <i class="bi bi-plus-lg"></i> Add Book
    </a>
</div>

<div class="card-body">
    <div class="overflow-x-auto">
        <table class="min-w-full bg-white rounded-xl shadow-lg overflow-hidden">
            <thead class="bg-[#4f46e5]">
                <tr>
                    <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">#</th>
                    <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Title</th>
                    <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Author</th>
                    <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Category</th>
                    <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Price</th>
                    <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Published</th>
                    <th class="py-3 px-5 text-center text-sm font-semibold uppercase tracking-wider text-white">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-indigo-100">
                @if (Model.Books != null && Model.Books.Any())
                {
                    var index = (Model.CurrentPage - 1) * 10 + 1;

                    foreach (var book in Model.Books)
                    {
                        <tr class="transition duration-200 hover:bg-indigo-50">
                            <td class="py-3 px-5 text-sm text-gray-700">@index</td>

                            <td class="py-3 px-5 text-sm text-indigo-900 font-medium">
                                @book.BookName
                            </td>

                            <td class="py-3 px-5 text-sm text-gray-800">
                                @book.Author
                            </td>

                            <td class="py-3 px-5 text-sm text-gray-800">
                                @book.Category?.CategoryName
                            </td>

                            <td class="py-3 px-5 text-sm text-gray-800 font-medium">
                                Rs.@book.Price.ToString("0.00")
                            </td>

                            <td class="py-3 px-5 text-sm text-gray-700">
                                @book.PublicationDate?.ToString("yyyy-MM-dd")
                            </td>

                            <td class="py-3 px-5 text-center">
                                <div class="flex justify-center gap-2">

                                    <button type="button"
                                            onclick="addMoreBooks(@book.BookId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(book.BookName ?? ""))')"
                                            class="px-3 py-1 bg-green-500 text-white rounded-lg shadow hover:bg-green-600 transition"
                                            title="Add More Copies">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>

                                    <a href="@Url.Action("Edit", "Book", new { id = book.BookId })"
                                       class="px-3 py-1 bg-yellow-400 text-white rounded-lg shadow hover:bg-yellow-500 transition"
                                       title="Edit Book">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <button type="button"
                                            onclick="deleteBook(@book.BookId)"
                                            class="px-3 py-1 bg-red-500 text-white rounded-lg shadow hover:bg-red-600 transition"
                                            title="Delete Book">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>

                                </div>
                            </td>
                        </tr>

                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-6 text-center text-gray-400 text-lg font-medium">
                            No books available.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex flex-wrap justify-between items-center gap-3 mt-5">

            <span class="text-sm text-gray-500">
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            <div class="flex flex-wrap gap-2">

                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })"
                       class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-700">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                }

                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a href="@Url.Action("Index", new { page = pageNumber })"
                       class="px-3 py-2 rounded-lg text-sm @(pageNumber == Model.CurrentPage ? "bg-indigo-600 text-white" : "bg-gray-100 hover:bg-gray-200 text-gray-700")">
                        @pageNumber
                    </a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })"
                       class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-700">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                }

            </div>
        </div>
    }
</div>

@section Scripts {
    <script>


        async function addMoreBooks(bookId, bookName) {

            const { value: quantity } = await Swal.fire({
                title: 'Add More Copies',
                text: `Book: ${bookName}`,
                input: 'number',
                inputAttributes: {
                    min: 1,
                    step: 1,
                    placeholder: 'Enter quantity'
                },
                inputPlaceholder: 'Enter additional quantity',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Add Copies',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    const qty = Number(value);

                    if (!Number.isSafeInteger(qty) || qty < 1) {
                        return 'Please enter a valid quantity greater than 0.';
                    }
                }
            });

            if (!quantity) return;

            try {
                const response = await secureFetch('/api/book-api/AddMore', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        BookId: bookId,
                        Quantity: Number(quantity)
                    })
                });

                if (response.ok) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Copies Added!',
                        text: `${quantity} additional copies of ${bookName} have been added.`,
                        timer: 2000,
                        showConfirmButton: false
                    });

                    window.location.reload();
                } else {
                    let errorMessage = 'Unable to add more copies. Please try again.';

                    try {
                        const data = await response.json();
                        errorMessage = data.message || data.Message || errorMessage;
                    } catch {
                    }

                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: errorMessage
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Something went wrong. Please try again.'
                });
            }
}


        async function deleteBook(bookId) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            });

            if (!result.isConfirmed) return;

            const response = await secureFetch(`/api/book-api/Delete/${bookId}`, {
                method: 'DELETE',
            });

            if (response.ok) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'Book has been deleted.',
                    timer: 1500,
                    showConfirmButton: false
                });

                window.location.reload();
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Something went wrong! Please try again.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        }

    </script>
}