 @model Library_Management_System.ViewModels.IssuedBooksViewModel

@{
    ViewData["Title"] = "Issued Books";
    ViewData["ActiveMenu"] = "IssuedBook";
    ViewData["PageHeading"] = "Issued Books";
}

<div class="card-body">
    <div class="mb-4 border-b border-gray-200">
        <div class="flex gap-6">
            <button type="button" id="rentTab"
                    onclick="showTab('rent')"
                    class="tab-button py-3 px-4 text-sm font-semibold border-b-2 border-indigo-600 text-indigo-600">
                <i class="bi bi-book-half mr-1"></i> Rent
            </button>

            <button type="button" id="salesTab"
                    onclick="showTab('sales')"
                    class="tab-button py-3 px-4 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-indigo-600">
                <i class="bi bi-cart-check mr-1"></i> Sales
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">

        <div id="rentContent">
            <table class="min-w-full bg-white rounded-xl shadow-lg overflow-hidden">
                <thead class="bg-[#4f46e5]">
                    <tr>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">#</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Book Name</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Student Name</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Status</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Rented At</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-indigo-100">
                    @if (Model.RentBooks != null && Model.RentBooks.Any())
                    {
                        var index = (Model.RentPage - 1) * 10 + 1;

                        foreach (var item in Model.RentBooks)
                        {
                            <tr class="transition duration-200 hover:bg-indigo-50">
                                <td class="py-3 px-5 text-sm text-gray-700">@index</td>
                                <td class="py-3 px-5 text-sm text-indigo-900 font-medium">@item.BookName</td>
                                <td class="py-3 px-5 text-sm text-gray-800">@item.StudentName</td>
                                <td class="py-3 px-5 text-sm text-indigo-900 font-medium">@item.Status</td>
                                <td class="py-3 px-5 text-sm text-gray-700">@item.RentedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="py-6 text-center text-gray-400 text-lg font-medium">
                                No rented books available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.RentTotalPages > 1)
            {
                <div class="flex flex-wrap justify-between items-center gap-3 mt-5">
                    <span class="text-sm text-gray-500">
                        Page @Model.RentPage of @Model.RentTotalPages
                    </span>

                    <div class="flex flex-wrap gap-2">
                        @if (Model.RentPage > 1)
                        {
                            <a href="@Url.Action("Index", new { rentPage = Model.RentPage - 1, salesPage = Model.SalesPage, tab = "rent" })"
                               class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-700">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        }

                        @for (var pageNumber = 1; pageNumber <= Model.RentTotalPages; pageNumber++)
                        {
                            <a href="@Url.Action("Index", new { rentPage = pageNumber, salesPage = Model.SalesPage, tab = "rent" })"
                               class="px-3 py-2 rounded-lg text-sm @(pageNumber == Model.RentPage ? "bg-indigo-600 text-white" : "bg-gray-100 hover:bg-gray-200 text-gray-700")">
                                @pageNumber
                            </a>
                        }

                        @if (Model.RentPage < Model.RentTotalPages)
                        {
                            <a href="@Url.Action("Index", new { rentPage = Model.RentPage + 1, salesPage = Model.SalesPage, tab = "rent" })"
                               class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-700">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <div id="salesContent" class="hidden">
            <table class="min-w-full bg-white rounded-xl shadow-lg overflow-hidden">
                <thead class="bg-[#4f46e5]">
                    <tr>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">#</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Date</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Book Name</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Student Name</th>
                        <th class="py-3 px-5 text-left text-sm font-semibold uppercase tracking-wider text-white">Price</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-indigo-100">
                    @if (Model.SalesBooks != null && Model.SalesBooks.Any())
                    {
                        var index = (Model.SalesPage - 1) * 10 + 1;

                        foreach (var item in Model.SalesBooks)
                        {
                            <tr class="transition duration-200 hover:bg-indigo-50">
                                <td class="py-3 px-5 text-sm text-gray-700">@index</td>
                                <td class="py-3 px-5 text-sm text-gray-700">@item.Date.ToString("yyyy-MM-dd")</td>
                                <td class="py-3 px-5 text-sm text-indigo-900 font-medium">@item.BookName</td>
                                <td class="py-3 px-5 text-sm text-gray-800">@item.StudentName</td>
                                <td class="py-3 px-5 text-sm text-gray-800 font-medium">Rs.@item.Price.ToString("0.00")</td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-6 text-center text-gray-400 text-lg font-medium">
                                No sales available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.SalesTotalPages > 1)
            {
                <div class="flex flex-wrap justify-between items-center gap-3 mt-5">
                    <span class="text-sm text-gray-500">
                        Page @Model.SalesPage of @Model.SalesTotalPages
                    </span>

                    <div class="flex flex-wrap gap-2">
                        @if (Model.SalesPage > 1)
                        {
                            <a href="@Url.Action("Index", new { rentPage = Model.RentPage, salesPage = Model.SalesPage - 1, tab = "sales" })"
                               class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-700">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        }

                        @for (var pageNumber = 1; pageNumber <= Model.SalesTotalPages; pageNumber++)
                        {
                            <a href="@Url.Action("Index", new { rentPage = Model.RentPage, salesPage = pageNumber, tab = "sales" })"
                               class="px-3 py-2 rounded-lg text-sm @(pageNumber == Model.SalesPage ? "bg-indigo-600 text-white" : "bg-gray-100 hover:bg-gray-200 text-gray-700")">
                                @pageNumber
                            </a>
                        }

                        @if (Model.SalesPage < Model.SalesTotalPages)
                        {
                            <a href="@Url.Action("Index", new { rentPage = Model.RentPage, salesPage = Model.SalesPage + 1, tab = "sales" })"
                               class="px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm text-gray-700">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function showTab(tab) {
            const rentContent = document.getElementById('rentContent');
            const salesContent = document.getElementById('salesContent');
            const rentTab = document.getElementById('rentTab');
            const salesTab = document.getElementById('salesTab');

            rentContent.classList.toggle('hidden', tab !== 'rent');
            salesContent.classList.toggle('hidden', tab !== 'sales');

            rentTab.classList.toggle('border-indigo-600', tab === 'rent');
            rentTab.classList.toggle('text-indigo-600', tab === 'rent');
            rentTab.classList.toggle('border-transparent', tab !== 'rent');
            rentTab.classList.toggle('text-gray-500', tab !== 'rent');

            salesTab.classList.toggle('border-indigo-600', tab === 'sales');
            salesTab.classList.toggle('text-indigo-600', tab === 'sales');
            salesTab.classList.toggle('border-transparent', tab !== 'sales');
            salesTab.classList.toggle('text-gray-500', tab !== 'sales');
        }

        showTab('@Model.ActiveTab');
    </script>
}