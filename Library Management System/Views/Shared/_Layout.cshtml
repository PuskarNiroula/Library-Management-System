@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var activeMenu = ViewData["ActiveMenu"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="/css/custom.css"/>
    
    <link rel="stylesheet" href="~/css/admin.css" />
    @await RenderSectionAsync("HeadScript", false)
</head>
<body  class="bg-gray-100 font-sans">

<div class="flex min-h-screen w-full">


<aside id="sidebar" class="w-64 bg-white shadow-lg p-5 space-y-2 sticky top-0 h-screen overflow-y-auto">

    <h3 class="text-gray-500 uppercase text-xs font-semibold mb-4 tracking-wider">
        Main Menu
    </h3>

    <a asp-controller="Home" asp-action="Index"
       class="sidebar-link @(activeMenu == "Dashboard" ? "active" : "")">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
    </a>

    <div class="pt-4">
        <h3 class="text-gray-400 uppercase text-xs font-semibold mb-2 tracking-wider">
            Library Management
        </h3>

        <a asp-controller="Book" asp-action="Index"
           class="sidebar-link @(activeMenu == "Book" ? "active" : "")">
            <i class="bi bi-book-half me-2"></i> Books
        </a>

        <a asp-controller="Category" asp-action="Index"
           class="sidebar-link @(activeMenu == "Category" ? "active" : "")">
            <i class="bi bi-bookmark-plus me-2"></i> Categories
        </a>

        <a asp-controller="User" asp-action="Index"
           class="sidebar-link @(activeMenu == "Users" ? "active" : "")">
            <i class="bi bi-people-fill me-2"></i> Users
        </a>
    </div>

    <div class="pt-4">
        <h3 class="text-gray-400 uppercase text-xs font-semibold mb-2 tracking-wider">
            Transactions
        </h3>

        <a asp-controller="Request" asp-action="Index"
           class="sidebar-link @(activeMenu == "Request" ? "active" : "")">
            <i class="bi bi-inbox me-2"></i> Requests
        </a>

        
        <div class="space-y-1">

            <button type="button" id="circulationToggle"
                    class="sidebar-link w-full flex items-center justify-between @(activeMenu == "Circulation" || activeMenu == "CheckOut" || activeMenu == "CheckIn" || activeMenu == "Renew" ? "active" : "")">
                <span>
                    <i class="bi bi-arrow-left-right me-2"></i> Circulation
                </span>
                <i class="bi bi-chevron-down text-xs transition-transform" id="circulationArrow"></i>
            </button>

            <div id="circulationSubmenu"
                 class="pl-8 space-y-1 @(activeMenu == "Circulation" || activeMenu == "CheckOut" || activeMenu == "CheckIn" || activeMenu == "Renew" ? "" : "hidden")">

                <a asp-controller="Circulation" asp-action="CheckOut"
                   class="sidebar-link text-sm @(activeMenu == "CheckOut" ? "active" : "")">
                    <i class="bi bi-box-arrow-up-right me-2"></i> Check Out
                </a>

                <a asp-controller="Circulation" asp-action="CheckIn"
                   class="sidebar-link text-sm @(activeMenu == "CheckIn" ? "active" : "")">
                    <i class="bi bi-box-arrow-in-left me-2"></i> Check In
                </a>

                <a asp-controller="Circulation" asp-action="Renew"
                   class="sidebar-link text-sm @(activeMenu == "Renew" ? "active" : "")">
                    <i class="bi bi-arrow-repeat me-2"></i> Renew Book
                </a>

            </div>
        </div>


        <a asp-controller="IssuedBooks" asp-action="Index"
           class="sidebar-link @(activeMenu == "IssuedBooks" ? "active" : "")">
            <i class="bi bi-journal-check me-2"></i> Issued Books
        </a>
    </div>

    <div class="pt-4">
        <h3 class="text-gray-400 uppercase text-xs font-semibold mb-2 tracking-wider">
            Analytics & Configuration
        </h3>

        <a asp-controller="Reports" asp-action="Index"
           class="sidebar-link @(activeMenu == "Reports" ? "active" : "")">
            <i class="bi bi-graph-up me-2"></i> Reports
        </a>

        <a asp-controller="Settings" asp-action="Index"
           class="sidebar-link @(activeMenu == "Settings" ? "active" : "")">
            <i class="bi bi-gear-fill me-2"></i> Settings
        </a>
    </div>

</aside>

    <div class="flex flex-col flex-1 w-full overflow-y-auto">
        <nav class="bg-white shadow-md px-6 py-4 flex justify-between items-center z-10 border-b border-gray-200">

            <div class="flex items-center gap-4">
                <button id="toggleSidebar"
                        class="text-gray-600 hover:text-indigo-600 focus:outline-none transition">
                    <i class="fa-solid fa-bars text-2xl"></i>
                </button>

                <div class="flex items-center gap-2 text-2xl font-bold text-indigo-600">
                    <i class="fa-solid fa-book-open text-indigo-600"></i>
                    <span class="hidden sm:block">Our Library</span>
                </div>
            </div>
            <div class="flex items-center gap-4">

                <div class="hidden md:block text-gray-700">
                    Hello, <span class="font-semibold text-indigo-600">@User.Identity?.Name</span>
                </div>
                    <button type="button" onclick="logout()"
                            class="flex items-center bg-indigo-600 text-white px-4 py-2 rounded-lg 
                           hover:bg-indigo-700 active:bg-indigo-800 transition duration-200 shadow-sm">
                        <i class="fa-solid fa-right-from-bracket mr-2"></i>
                        <span class="hidden sm:inline">Logout</span>
                    </button>
               
            </div>
        </nav>

        <main class="flex-1 p-8 bg-gray-50">
            @RenderBody()
        </main>
    </div>
   
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/AuthHelper.js"></script>
<script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
        });
        
        function logout() {
            localStorage.removeItem("token");
            
            $.ajax({
                url: "/api/auth/logout",
                method: "POST",
                dataType: "json",
                success: function () {
                    location.href="/";
                }
            });
            
        }
</script>

@await RenderSectionAsync("Scripts", required: false)

<script>
    const circulationToggle = document.getElementById('circulationToggle');
    const circulationSubmenu = document.getElementById('circulationSubmenu');
    const circulationArrow = document.getElementById('circulationArrow');

    circulationToggle.addEventListener('click', () => {
        circulationSubmenu.classList.toggle('hidden');
        circulationArrow.classList.toggle('rotate-180');
    });

    if (!circulationSubmenu.classList.contains('hidden')) {
        circulationArrow.classList.add('rotate-180');
    }
</script>

</body>
</html>
